$isi = @"
PORT=3000
APP_ENV=development
# Mongo di Docker (Windows/Mac) butuh directConnection=true
MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true
DB_NAME=smartcoop
MAX_UPLOAD_MB=50
WORKERS=4
"@
[IO.File]::WriteAllText("$PWD\.env.example", $isi, (New-Object Text.UTF8Encoding $false))
Get-Content .env.example